*.gguf

# Ignore all logs by default, but allow metrics + curves
logs/
!logs/sac/
!logs/sac/sac_metrics.csv
!logs/sac/sac_curves.png
!logs/sac_5m/
!logs/sac_5m/sac_metrics.csv
!logs/sac_5m/sac_curves.png
